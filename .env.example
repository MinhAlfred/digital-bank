# Reference only: Spring Boot does not automatically load .env files.
# Set these values in each Java process's environment or IDE run configuration.
SPRING_PROFILES_ACTIVE=local

# All five database-backed services. Use the matching service database credentials.
DB_USERNAME=
DB_PASSWORD=
# Local profile supplies each service's own URL. Production requires DB_URL.
# DB_URL=jdbc:postgresql://database-host:5432/service-database

# Required by database-backed services in production; local defaults to localhost:9092.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Gateway, Core and Customer must use matching JWT settings.
APP_SECURITY_JWT_SECRET=
APP_SECURITY_JWT_ISSUER=
APP_SECURITY_JWT_AUDIENCE=

# Gateway only.
GATEWAY_INTERNAL_SECRET=
# All five destination URLs are required for Gateway in production.
# CUSTOMER_SERVICE_URI=https://customer.example.internal
# CORE_BANKING_SERVICE_URI=https://core.example.internal
# NOTIFICATION_SERVICE_URI=https://notification.example.internal
# FRAUD_DETECTION_SERVICE_URI=https://fraud.example.internal
# ANALYSIS_SERVICE_URI=https://analytics.example.internal

# Core only. Local profile defaults to http://localhost:4001.
# APP_CUSTOMER_SERVICE_BASE_URL=https://customer.example.internal
